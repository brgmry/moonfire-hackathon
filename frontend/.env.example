# Cloud Run backend URL (no trailing slash). Fixture backend: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Site gate. Leave all three unset for an open local build.
# SITE_PASSWORD=   the password people type on /login
# SITE_TOKEN=      shared with the backend (its SITE_TOKEN env); sent as a bearer header / ?token= on every API call
# AUTH_SECRET=     random; signs the login cookie
