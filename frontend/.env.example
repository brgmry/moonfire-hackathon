# Cloud Run backend URL (no trailing slash). Fixture backend: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# 1: every visitor talks to the backend above (local only, npm run demo sets it). Unset: recorded runs only, unless logged in.
# NEXT_PUBLIC_LIVE=1
# Team login for real runs. Leave both unset and /login refuses everyone.
# SITE_PASSWORD=   the password people type on /login
# SITE_TOKEN=      shared with the backend (its SITE_TOKEN env); sent as a bearer header / ?token= on every API call
